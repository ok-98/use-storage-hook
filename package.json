{
  "name": "use-storage-hook",
  "private": false,
  "version": "1.1.0",
  "description": "A React hook for managing localStorage and sessionStorage",
  "author": {
    "name": "Kacper Olszanski",
    "url": "https://github.com/ok-98/"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ok-98/use-storage-hook"
  },
  "bugs": {
    "url": "https://github.com/ok-98/use-storage-hook/issues"
  },
  "homepage": "https://github.com/ok-98/use-storage-hook#readme",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/use-storage-hook.umd.cjs",
  "module": "./dist/use-storage-hook.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/use-storage-hook.js",
      "require": "./dist/use-storage-hook.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint . --ext ts",
    "lint:fix": "eslint --fix .",
    "changeset": "changeset"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "hook",
    "storage",
    "localStorage",
    "sessionStorage",
    "state"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/css": "^0.13.0",
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "only-utils": "^1.0.0"
  }
}